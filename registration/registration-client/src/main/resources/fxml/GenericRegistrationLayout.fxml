<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.RowConstraints?>

<!-- CEIN: registration flow layout. GenericController adds the process title to
     navigationAnchorPane and the screens (TabPane = steps) to anchorPane. -->
<GridPane fx:id="genericScreen" styleClass="parentPane, ceinFlow" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="io.mosip.registration.controller.GenericController">
   <columnConstraints>
      <ColumnConstraints hgrow="ALWAYS" />
   </columnConstraints>
   <rowConstraints>
      <RowConstraints minHeight="56.0" />
      <RowConstraints vgrow="ALWAYS" />
      <RowConstraints minHeight="72.0" />
   </rowConstraints>
   <children>
      <AnchorPane fx:id="navigationAnchorPane" styleClass="ceinFlowHeader" GridPane.rowIndex="0" />

      <AnchorPane fx:id="anchorPane" minHeight="200.0" styleClass="paneAtDisplayDemoGraphic, ceinFlowContent" GridPane.rowIndex="1" />

      <GridPane fx:id="footerGridPane" hgap="12.0" styleClass="ceinFlowFooter" GridPane.rowIndex="2">
         <columnConstraints>
            <ColumnConstraints hgrow="ALWAYS" />
            <ColumnConstraints halignment="RIGHT" />
         </columnConstraints>
         <rowConstraints>
            <RowConstraints vgrow="ALWAYS" />
         </rowConstraints>
         <children>
            <Label fx:id="notification" maxWidth="Infinity" styleClass="registrationErrorMsg, ceinError" wrapText="true" />
            <Button fx:id="next" mnemonicParsing="false" styleClass="contiuneButton" text="%continue" GridPane.columnIndex="1" />
            <Button fx:id="authenticate" mnemonicParsing="false" styleClass="contiuneButton" text="%authenticate" GridPane.columnIndex="1" />
         </children>
      </GridPane>
   </children>
</GridPane>
