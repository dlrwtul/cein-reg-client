<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Menu?>
<?import javafx.scene.control.MenuBar?>
<?import javafx.scene.control.MenuItem?>
<?import javafx.scene.control.SeparatorMenuItem?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- CEIN: top bar of the logged-in screens (design "Topbar"): page title, network status and last
     synchronisation, device shortcuts, user menu (MOSIP menu items: operations, user guide, reset
     password, logout). The centre and the machine are shown at the bottom of the navigation.
     Every fx:id / handler of HeaderController is kept. -->
<GridPane fx:id="headerParent" hgap="16.0" styleClass="ceinTopbar" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="io.mosip.registration.controller.reg.HeaderController">
  <columnConstraints>
    <ColumnConstraints hgrow="ALWAYS" minWidth="120.0" />
    <ColumnConstraints />
    <ColumnConstraints />
    <ColumnConstraints />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints minHeight="64.0" valignment="CENTER" />
  </rowConstraints>
  <children>
    <Label fx:id="ceinPageTitle" minWidth="0.0" styleClass="ceinTopbarTitle" text="%ceinHomeTitle" />

    <!-- network status and last synchronisation -->
    <HBox alignment="CENTER_LEFT" spacing="8.0" styleClass="ceinTopbarStatus" GridPane.columnIndex="1">
      <children>
        <StackPane>
          <children>
            <HBox fx:id="online" alignment="CENTER_LEFT" managed="${online.visible}" spacing="8.0">
              <children>
                <SVGPath content="M5 12.5a10 10 0 0 1 14 0M8.5 16a5 5 0 0 1 7 0M12 19.5h0M1.5 9a15 15 0 0 1 21 0" styleClass="ceinIconStroke" />
                <Label styleClass="ceinTopbarStatusText" text="%ceinOnline" />
                <ImageView fx:id="availableIcon1" fitHeight="1.0" fitWidth="1.0" managed="false" visible="false" />
              </children>
            </HBox>
            <HBox fx:id="offline" alignment="CENTER_LEFT" managed="${offline.visible}" spacing="8.0" visible="false">
              <children>
                <SVGPath content="M2 2l20 20M8.5 16a5 5 0 0 1 7 0M12 19.5h0M5 12.5a10 10 0 0 1 5-2.7M1.5 9a15 15 0 0 1 4.5-3M19 12.5a10 10 0 0 0-2.4-1.7M22.5 9a15 15 0 0 0-11-4.4" styleClass="ceinIconStroke, ceinIconDanger" />
                <Label styleClass="ceinTopbarStatusText, ceinTopbarOffline" text="%ceinOffline" />
                <ImageView fx:id="availableIcon" fitHeight="1.0" fitWidth="1.0" managed="false" visible="false" />
              </children>
            </HBox>
          </children>
        </StackPane>
        <Label fx:id="ceinLastSync" styleClass="ceinTopbarStatusText" />
      </children>
    </HBox>

    <!-- device shortcuts created from the settings (MOSIP) -->
    <HBox fx:id="settingsHBox" alignment="CENTER_LEFT" spacing="16.0" GridPane.columnIndex="2" />

    <!-- user menu -->
    <HBox alignment="CENTER_RIGHT" GridPane.columnIndex="3">
      <children>
        <MenuBar fx:id="menu" styleClass="menuBar, ceinUserMenuBar">
          <menus>
            <Menu fx:id="homeSelectionMenu" mnemonicParsing="false" onAction="#closeOperations" styleClass="ceinUserMenu">
              <graphic>
                <HBox alignment="CENTER_LEFT" spacing="10.0" styleClass="ceinUserPill">
                  <children>
                    <StackPane styleClass="ceinAvatar">
                      <children>
                        <Label fx:id="ceinUserInitials" styleClass="ceinAvatarText" />
                      </children>
                    </StackPane>
                    <Label fx:id="registrationOfficerName" styleClass="ceinUserName" text="%roname" />
                    <SVGPath content="M6 9l6 6 6-6" styleClass="ceinIconStroke" />
                    <ImageView fx:id="homeSelectionMenuImageView" fitHeight="1.0" fitWidth="1.0" managed="false" visible="false" />
                  </children>
                </HBox>
              </graphic>
              <items>
                <MenuItem fx:id="userGuide" mnemonicParsing="false" onAction="#userGuide" text="%userGuide" />
                <SeparatorMenuItem />
                <MenuItem fx:id="resetPword" mnemonicParsing="false" onAction="#resetPword" text="%resetPassword" />
                <SeparatorMenuItem />
                <MenuItem fx:id="logout" mnemonicParsing="false" onAction="#logout" text="%logout" />
              </items>
            </Menu>
          </menus>
        </MenuBar>
      </children>
    </HBox>

    <!-- MOSIP header items shown elsewhere in the CEIN layout (navigation: home, settings, centre, machine) -->
    <VBox managed="false" visible="false">
      <children>
        <HBox fx:id="settingsIconHBox" visible="false">
          <children>
            <ImageView fitHeight="1.0" fitWidth="1.0" onMouseClicked="#openSettings" />
          </children>
        </HBox>
        <ImageView fx:id="mosipLogo" fitHeight="1.0" fitWidth="1.0" />
        <ImageView fx:id="homeImgView" fitHeight="1.0" fitWidth="1.0" onMousePressed="#redirectHome" />
        <Label fx:id="registrationOfficeLocation" text="%rooffice">
          <graphic><ImageView fx:id="regCenterLocationImgView" fitHeight="1.0" fitWidth="1.0" /></graphic>
        </Label>
        <Label fx:id="registrationOfficeId" text="%roid">
          <graphic><ImageView fx:id="registrationOfficeIdImageView" fitHeight="1.0" fitWidth="1.0" /></graphic>
        </Label>
        <ImageView fx:id="userImageView" fitHeight="1.0" fitWidth="1.0" />
      </children>
    </VBox>
  </children>
</GridPane>
