<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>

<!-- CEIN: validation of the registration (design "AuthOperateur"). Card 1: registration officer,
     card 2: supervisor (shown when a biometric exception requires the reviewer authentication).
     The mode (password, OTP, fingerprint, iris, face) follows the server configuration per role;
     AuthenticationController shows one of the panes below and moves them into the card being
     authenticated. Every fx:id / handler of the controller is kept. -->
<GridPane fx:id="operatorAuthenticationPane" styleClass="ceinAuth" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="io.mosip.registration.controller.auth.AuthenticationController">
  <columnConstraints>
    <ColumnConstraints hgrow="ALWAYS" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints vgrow="ALWAYS" />
    <RowConstraints />
  </rowConstraints>
  <children>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="ceinFormScroll">
      <content>
        <VBox spacing="20.0" styleClass="ceinAuthBody">
          <children>
            <VBox spacing="2.0">
              <children>
                <Label styleClass="ceinAuthTitle" text="%ceinAuthTitle" />
                <Label styleClass="ceinMuted" text="%ceinAuthSubtitle" wrapText="true" />
              </children>
            </VBox>

            <GridPane hgap="20.0" vgap="20.0">
              <columnConstraints>
                <ColumnConstraints hgrow="ALWAYS" minWidth="360.0" percentWidth="50.0" />
                <ColumnConstraints hgrow="ALWAYS" minWidth="360.0" percentWidth="50.0" />
              </columnConstraints>
              <rowConstraints>
                <RowConstraints valignment="TOP" />
              </rowConstraints>
              <children>

                <!-- 1. registration officer -->
                <VBox fx:id="ceinAuthOperatorCard" maxHeight="-Infinity" spacing="18.0" styleClass="ceinCard, ceinAuthCard">
                  <children>
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                      <children>
                        <StackPane fx:id="ceinAuthOperatorBadge" styleClass="ceinAuthBadge">
                          <children>
                            <Label fx:id="ceinAuthOperatorNumber" styleClass="ceinAuthBadgeText" text="1" />
                            <SVGPath fx:id="ceinAuthOperatorCheck" content="M5 12 L10 17 L19 7" managed="false" styleClass="ceinAuthBadgeCheck" visible="false" />
                          </children>
                        </StackPane>
                        <VBox spacing="2.0">
                          <children>
                            <Label styleClass="ceinAuthCardTitle" text="%ceinAuthOperator" />
                            <Label fx:id="ceinAuthOperatorStatus" styleClass="ceinAuthStatus" />
                          </children>
                        </VBox>
                      </children>
                    </HBox>
                    <GridPane hgap="12.0" styleClass="ceinAuthIdentity" vgap="8.0">
                      <columnConstraints>
                        <ColumnConstraints minWidth="140.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                      </columnConstraints>
                      <children>
                        <Label styleClass="ceinAuthTerm" text="%ceinAuthUserId" />
                        <Label fx:id="ceinAuthOperatorId" styleClass="ceinAuthValueStrong" GridPane.columnIndex="1" />
                        <Label styleClass="ceinAuthTerm" text="%ceinAuthName" GridPane.rowIndex="1" />
                        <Label fx:id="ceinAuthOperatorName" styleClass="ceinAuthValue" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                      </children>
                    </GridPane>
                    <VBox fx:id="ceinAuthOperatorSlot">
                      <children>

                        <!-- authentication panes: one is visible at a time -->
                        <VBox fx:id="ceinAuthPanes" spacing="12.0">
                          <children>
                            <StackPane fx:id="contentHolder" alignment="TOP_LEFT">
                              <children>

                                <GridPane fx:id="errorPane" managed="${errorPane.visible}" visible="false">
                                  <columnConstraints><ColumnConstraints hgrow="ALWAYS" /></columnConstraints>
                                  <children>
                                    <VBox spacing="8.0">
                                      <children>
                                        <Label fx:id="errorLabel" styleClass="ceinAuthMode" text="%registrationofficerverification" />
                                        <Label fx:id="errorText1" styleClass="ceinError" wrapText="true" />
                                        <Label fx:id="errorText2" styleClass="ceinError" wrapText="true" />
                                      </children>
                                    </VBox>
                                  </children>
                                </GridPane>

                                <GridPane fx:id="pwdBasedLogin" managed="${pwdBasedLogin.visible}" visible="false">
                                  <columnConstraints><ColumnConstraints hgrow="ALWAYS" /></columnConstraints>
                                  <children>
                                    <VBox spacing="14.0">
                                      <children>
                                        <Label fx:id="pwdLabel" styleClass="ceinAuthMode" text="%pwdAuthentication" />
                                        <VBox spacing="6.0">
                                          <children>
                                            <Label styleClass="ceinFieldLabel" text="%username" />
                                            <TextField fx:id="username" styleClass="ceinAuthField" />
                                          </children>
                                        </VBox>
                                        <VBox spacing="6.0">
                                          <children>
                                            <Label styleClass="ceinFieldLabel" text="%password" />
                                            <PasswordField fx:id="password" styleClass="ceinAuthField" />
                                          </children>
                                        </VBox>
                                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToNextPage" styleClass="contiuneButton, ceinAuthSubmit" text="%ceinAuthValidate" />
                                      </children>
                                    </VBox>
                                  </children>
                                </GridPane>

                                <GridPane fx:id="otpBasedLogin" managed="${otpBasedLogin.visible}" visible="false">
                                  <columnConstraints><ColumnConstraints hgrow="ALWAYS" /></columnConstraints>
                                  <children>
                                    <VBox spacing="14.0">
                                      <children>
                                        <Label fx:id="otpLabel" styleClass="ceinAuthMode" text="%otpAuthentication" />
                                        <VBox spacing="6.0">
                                          <children>
                                            <Label styleClass="ceinFieldLabel" text="%username" />
                                            <TextField fx:id="otpUserId" styleClass="ceinAuthField" />
                                          </children>
                                        </VBox>
                                        <Button fx:id="getOTP" maxWidth="Infinity" mnemonicParsing="false" onAction="#generateOtp" styleClass="ceinSecondary, ceinAuthSubmit" text="%getotp" />
                                        <VBox spacing="6.0">
                                          <children>
                                            <Label styleClass="ceinFieldLabel" text="%enterotp" />
                                            <TextField fx:id="otp" styleClass="ceinAuthField" />
                                          </children>
                                        </VBox>
                                        <Label fx:id="otpValidity" styleClass="ceinMuted" wrapText="true" />
                                        <Button maxWidth="Infinity" mnemonicParsing="false" onAction="#goToNextPage" styleClass="contiuneButton, ceinAuthSubmit" text="%ceinAuthValidate" />
                                      </children>
                                    </VBox>
                                  </children>
                                </GridPane>

                                <GridPane fx:id="fingerprintBasedLogin" managed="${fingerprintBasedLogin.visible}" visible="false">
                                  <columnConstraints><ColumnConstraints hgrow="ALWAYS" /></columnConstraints>
                                  <children>
                                    <VBox spacing="14.0">
                                      <children>
                                        <Label fx:id="fpLabel" styleClass="ceinAuthMode" text="%fpAuthentication" />
                                        <VBox spacing="6.0">
                                          <children>
                                            <Label styleClass="ceinFieldLabel" text="%username" />
                                            <TextField fx:id="fpUserId" styleClass="ceinAuthField" />
                                          </children>
                                        </VBox>
                                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                                          <children>
                                            <GridPane fx:id="fingerPrintPane" alignment="CENTER" styleClass="fingerPrintPanes, ceinAuthBioBox">
                                              <children>
                                                <ImageView fx:id="rightHandImageView" fitHeight="96.0" fitWidth="96.0" pickOnBounds="true" preserveRatio="true" />
                                              </children>
                                            </GridPane>
                                            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                              <children>
                                                <Label styleClass="ceinMuted" text="%fingerprintinstruction" wrapText="true" />
                                                <Button fx:id="fingerPrintScanButton" mnemonicParsing="false" onAction="#scan" styleClass="contiuneButton, ceinAuthScan" text="%scan" />
                                              </children>
                                            </VBox>
                                          </children>
                                        </HBox>
                                      </children>
                                    </VBox>
                                  </children>
                                </GridPane>

                                <GridPane fx:id="irisBasedLogin" managed="${irisBasedLogin.visible}" visible="false">
                                  <columnConstraints><ColumnConstraints hgrow="ALWAYS" /></columnConstraints>
                                  <children>
                                    <VBox spacing="14.0">
                                      <children>
                                        <Label fx:id="irisLabel" styleClass="ceinAuthMode" text="%irisAuthentication" />
                                        <VBox spacing="6.0">
                                          <children>
                                            <Label styleClass="ceinFieldLabel" text="%username" />
                                            <TextField fx:id="irisUserId" styleClass="ceinAuthField" />
                                          </children>
                                        </VBox>
                                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                                          <children>
                                            <GridPane fx:id="irisPane" alignment="CENTER" styleClass="IrisPanes, ceinAuthBioBox">
                                              <children>
                                                <ImageView fx:id="irisImageView" fitHeight="96.0" fitWidth="96.0" pickOnBounds="true" preserveRatio="true" />
                                              </children>
                                            </GridPane>
                                            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                              <children>
                                                <Label styleClass="ceinMuted" text="%irisinstruction" wrapText="true" />
                                                <Button fx:id="irisScanButton" mnemonicParsing="false" onAction="#scan" styleClass="contiuneButton, ceinAuthScan" text="%scan" />
                                              </children>
                                            </VBox>
                                          </children>
                                        </HBox>
                                      </children>
                                    </VBox>
                                  </children>
                                </GridPane>

                                <GridPane fx:id="faceBasedLogin" managed="${faceBasedLogin.visible}" visible="false">
                                  <columnConstraints><ColumnConstraints hgrow="ALWAYS" /></columnConstraints>
                                  <children>
                                    <VBox spacing="14.0">
                                      <children>
                                        <Label fx:id="photoLabel" styleClass="ceinAuthMode" text="%photoAuthentication" />
                                        <VBox spacing="6.0">
                                          <children>
                                            <Label styleClass="ceinFieldLabel" text="%username" />
                                            <TextField fx:id="faceUserId" styleClass="ceinAuthField" />
                                          </children>
                                        </VBox>
                                        <HBox alignment="CENTER_LEFT" spacing="16.0">
                                          <children>
                                            <GridPane fx:id="photoPane" alignment="CENTER" styleClass="photoCapturePanes, ceinAuthBioBox">
                                              <children>
                                                <ImageView fx:id="faceImage" fitHeight="96.0" fitWidth="96.0" pickOnBounds="true" preserveRatio="true" />
                                              </children>
                                            </GridPane>
                                            <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                                              <children>
                                                <Label styleClass="ceinMuted" text="%faceinstruction" wrapText="true" />
                                                <Button fx:id="faceScanButton" mnemonicParsing="false" onAction="#scan" styleClass="contiuneButton, ceinAuthScan" text="%scan" />
                                              </children>
                                            </VBox>
                                          </children>
                                        </HBox>
                                      </children>
                                    </VBox>
                                  </children>
                                </GridPane>

                                <!-- biometric authentication in progress -->
                                <GridPane fx:id="progressIndicatorPane" alignment="CENTER" styleClass="ceinAuthProgress" visible="false">
                                  <children>
                                    <ProgressIndicator fx:id="progressIndicator" maxHeight="48.0" maxWidth="48.0" progress="0.0" visible="false" />
                                  </children>
                                </GridPane>
                              </children>
                            </StackPane>

                            <!-- biometric attempts (fingerprint / iris / face) -->
                            <HBox fx:id="ceinAuthAttempts" alignment="CENTER_LEFT" managed="${ceinAuthAttempts.visible}" spacing="6.0" visible="false">
                              <children>
                                <Label styleClass="ceinMuted" text="%attempts" />
                                <Label fx:id="authCounter" styleClass="ceinAuthValueStrong" />
                              </children>
                            </HBox>
                          </children>
                        </VBox>
                      </children>
                    </VBox>
                  </children>
                </VBox>

                <!-- 2. supervisor (biometric exception) -->
                <VBox fx:id="ceinAuthSupervisorCard" managed="${ceinAuthSupervisorCard.visible}" maxHeight="-Infinity" spacing="18.0" styleClass="ceinCard, ceinAuthCard" visible="false" GridPane.columnIndex="1">
                  <children>
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                      <children>
                        <StackPane fx:id="ceinAuthSupervisorBadge" styleClass="ceinAuthBadge">
                          <children>
                            <Label styleClass="ceinAuthBadgeText" text="2" />
                          </children>
                        </StackPane>
                        <VBox spacing="2.0">
                          <children>
                            <Label styleClass="ceinAuthCardTitle" text="%ceinAuthSupervisor" />
                            <Label fx:id="ceinAuthSupervisorStatus" styleClass="ceinAuthStatus, ceinAuthStatusWarn" text="%ceinAuthSupervisorRequired" wrapText="true" />
                          </children>
                        </VBox>
                      </children>
                    </HBox>
                    <VBox fx:id="ceinAuthSupervisorSlot" />
                  </children>
                </VBox>
              </children>
            </GridPane>
          </children>
        </VBox>
      </content>
    </ScrollPane>

    <!-- standalone use only: hidden by GenericController inside the registration flow -->
    <GridPane fx:id="backButton" hgap="12.0" managed="${backButton.visible}" styleClass="ceinFlowFooter" GridPane.rowIndex="1">
      <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" />
        <ColumnConstraints />
      </columnConstraints>
      <children>
        <Button fx:id="backBtn" mnemonicParsing="false" onAction="#goToPreviousPage" styleClass="backButton" text="%back">
          <graphic>
            <ImageView fx:id="backImageView" fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true" />
          </graphic>
        </Button>
        <Button fx:id="operatorAuthContinue" mnemonicParsing="false" onAction="#goToNextPage" styleClass="contiuneButton" text="%continue" GridPane.columnIndex="1">
          <graphic>
            <ImageView fx:id="continueImageView" fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true" />
          </graphic>
        </Button>
      </children>
    </GridPane>
  </children>
</GridPane>
