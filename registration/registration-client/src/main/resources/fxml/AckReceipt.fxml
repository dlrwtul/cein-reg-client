<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.web.WebView?>

<!-- CEIN: registration complete (design "Confirmation"). Left: confirmation, registration number,
     applicant, next steps, Print / New registration / Back to home. Right: preview of the receipt
     (server Velocity template) at the width of the configured roll. Every fx:id / handler of
     AckReceiptController is kept. -->
<GridPane id="anchor-pane-acknowledgement" fx:id="rootPane" styleClass="ceinAck" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="io.mosip.registration.controller.reg.AckReceiptController">
  <columnConstraints>
    <ColumnConstraints hgrow="ALWAYS" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints />
    <RowConstraints vgrow="ALWAYS" />
  </rowConstraints>
  <children>
    <GridPane fx:id="headerPage" styleClass="headerFooter">
      <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" />
      </columnConstraints>
      <children>
        <fx:include fx:id="Header" prefWidth="${headerPage.width}" source="Header.fxml" />
      </children>
    </GridPane>

    <GridPane hgap="24.0" styleClass="ceinAckBody" GridPane.rowIndex="1">
      <columnConstraints>
        <ColumnConstraints hgrow="ALWAYS" minWidth="420.0" />
        <ColumnConstraints maxWidth="420.0" minWidth="340.0" prefWidth="420.0" />
      </columnConstraints>
      <rowConstraints>
        <RowConstraints vgrow="ALWAYS" />
      </rowConstraints>
      <children>

        <!-- confirmation -->
        <VBox spacing="24.0" styleClass="ceinCard, ceinAckCard">
          <children>
            <HBox spacing="16.0">
              <children>
                <StackPane styleClass="ceinAckCheck">
                  <children>
                    <SVGPath content="M5 12 L10 17 L19 7" styleClass="ceinAckCheckMark" />
                  </children>
                </StackPane>
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                  <children>
                    <Label styleClass="ceinAckTitle" text="%ceinAckTitle" />
                    <Label styleClass="ceinAckSubtitle" text="%ceinAckSubtitle" wrapText="true" />
                  </children>
                </VBox>
              </children>
            </HBox>

            <GridPane hgap="16.0" styleClass="ceinAckDetails" vgap="12.0">
              <columnConstraints>
                <ColumnConstraints maxWidth="200.0" minWidth="140.0" />
                <ColumnConstraints hgrow="ALWAYS" />
              </columnConstraints>
              <children>
                <Label styleClass="ceinAckTerm" text="%ceinAckRid" />
                <Label fx:id="ceinAckRid" styleClass="ceinAckRid" wrapText="true" GridPane.columnIndex="1" />
                <Label fx:id="ceinAckApplicantTerm" managed="${ceinAckApplicantTerm.visible}" styleClass="ceinAckTerm" text="%ceinAckApplicant" GridPane.rowIndex="1" />
                <Label fx:id="ceinAckApplicant" managed="${ceinAckApplicant.visible}" styleClass="ceinAckValue" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="1" />
                <Label styleClass="ceinAckTerm" text="%ceinAckNext" GridPane.rowIndex="2" />
                <Label styleClass="ceinAckValue" text="%ceinAckNextValue" wrapText="true" GridPane.columnIndex="1" GridPane.rowIndex="2" />
              </children>
            </GridPane>

            <FlowPane hgap="12.0" vgap="12.0">
              <children>
                <Button fx:id="print" defaultButton="true" graphicTextGap="10.0" minWidth="-Infinity" mnemonicParsing="false" onAction="#printReceipt" styleClass="contiuneButton, ceinAckButton" text="%ceinAckPrint">
                  <graphic>
                    <StackPane>
                      <children>
                        <ImageView fx:id="printImgVw" fitHeight="1.0" fitWidth="1.0" managed="false" pickOnBounds="true" preserveRatio="true" visible="false" />
                        <SVGPath content="M6 9V3h12v6M3 9h18v8H3zM6 14h12v7H6z" styleClass="ceinIconStroke, ceinIconOnPrimary" />
                      </children>
                    </StackPane>
                  </graphic>
                </Button>
                <Button fx:id="newRegistration" graphicTextGap="10.0" minWidth="-Infinity" mnemonicParsing="false" onAction="#goToNewRegistration" styleClass="ceinSecondary, ceinAckButton" text="%ceinAckNew">
                  <graphic>
                    <StackPane>
                      <children>
                        <ImageView fx:id="newRegistrationBtnImgVw" fitHeight="1.0" fitWidth="1.0" managed="false" pickOnBounds="true" preserveRatio="true" visible="false" />
                        <SVGPath content="M12 5v14M5 12h14" styleClass="ceinIconStroke" />
                      </children>
                    </StackPane>
                  </graphic>
                </Button>
                <Hyperlink minHeight="48.0" onAction="#goToHome" styleClass="ceinAckHomeLink" text="%ceinAckHome" />
                <!-- MOSIP "download PDF" (not used in this configuration) -->
                <Button managed="false" mnemonicParsing="false" text="%downloadPDF" visible="false">
                  <graphic>
                    <ImageView fx:id="SendEmailImageView" fitHeight="1.0" fitWidth="1.0" pickOnBounds="true" preserveRatio="true" />
                  </graphic>
                </Button>
              </children>
            </FlowPane>

            <Region VBox.vgrow="ALWAYS" />
            <Label fx:id="ceinAckPrintNote" styleClass="ceinMuted" wrapText="true" />
          </children>
        </VBox>

        <!-- receipt preview -->
        <VBox styleClass="ceinAckPreview" GridPane.columnIndex="1">
          <children>
            <Label fx:id="ceinAckPreviewTitle" maxWidth="Infinity" styleClass="ceinAckPreviewTitle" text="%ceinAckPreview" />
            <StackPane alignment="TOP_CENTER" styleClass="ceinAckPreviewBody" VBox.vgrow="ALWAYS">
              <children>
                <StackPane fx:id="ceinAckPaper" maxWidth="302.0" prefWidth="302.0" styleClass="ceinAckPaper">
                  <children>
                    <WebView fx:id="webView" minHeight="-1.0" minWidth="-1.0" prefHeight="-1.0" prefWidth="-1.0" />
                  </children>
                </StackPane>
              </children>
            </StackPane>
          </children>
        </VBox>
      </children>
    </GridPane>
  </children>
</GridPane>
