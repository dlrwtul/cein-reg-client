<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressBar?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.VBox?>

<!-- CEIN: operator home. Every fx:id / handler used by PacketHandlerController is kept.
     Registration process tiles are added by the controller in registrationGridPane. -->
<GridPane fx:id="homeContent" styleClass="homeContent, ceinPage" xmlns="http://javafx.com/javafx/11" xmlns:fx="http://javafx.com/fxml/1"
  fx:controller="io.mosip.registration.controller.reg.PacketHandlerController">
  <columnConstraints>
    <ColumnConstraints hgrow="ALWAYS" />
  </columnConstraints>
  <rowConstraints>
    <RowConstraints vgrow="ALWAYS" />
  </rowConstraints>
  <children>
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="ceinHomeScroll">
      <content>
        <VBox fx:id="vHolder" spacing="22.0" styleClass="ceinHome">
          <children>

            <VBox spacing="4.0">
              <children>
                <Label styleClass="ceinTitle" text="%ceinHomeTitle" />
                <Label styleClass="ceinSubtitle" text="%ceinHomeSubtitle" />
              </children>
            </VBox>

            <HBox fx:id="userOnboardMessage" alignment="CENTER_LEFT" managed="${userOnboardMessage.visible}" spacing="10.0" styleClass="ceinNotice" visible="false">
              <children>
                <ImageView fx:id="tickMarkImageView" fitHeight="18.0" fitWidth="18.0" pickOnBounds="true" preserveRatio="true" />
                <Label fx:id="userOnboardMsg" text="%onboardAlertMsg" />
              </children>
            </HBox>

            <!-- registration processes (dynamic, one tile per active process spec) -->
            <VBox spacing="12.0">
              <children>
                <HBox alignment="BASELINE_LEFT" spacing="12.0">
                  <children>
                    <Label styleClass="ceinEyebrow" text="%registrationTasks" />
                    <Label styleClass="ceinMuted" text="%ceinHomeProcessesHint" />
                  </children>
                </HBox>
                <GridPane fx:id="registrationGridPane" hgap="16.0" vgap="16.0" />
              </children>
            </VBox>

            <HBox spacing="16.0">
              <children>

                <!-- operational tasks -->
                <VBox styleClass="ceinCard, ceinHomeList" HBox.hgrow="ALWAYS">
                  <children>
                    <Label maxWidth="Infinity" styleClass="ceinEyebrow, ceinHomeListTitle" text="%operationalTasks" />

                    <GridPane fx:id="syncDataPane" onMouseClicked="#syncData" styleClass="ceinHomeRow">
                      <columnConstraints>
                        <ColumnConstraints minWidth="40.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                      </columnConstraints>
                      <children>
                        <ImageView fx:id="syncDataImageView" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true" />
                        <VBox spacing="2.0" GridPane.columnIndex="1">
                          <children>
                            <Label styleClass="ceinHomeRowTitle" text="%synchronizeData" />
                            <HBox spacing="4.0">
                              <children>
                                <Label styleClass="ceinMuted" text="%lastsynctemp" />
                                <Label fx:id="lastSyncTime" styleClass="ceinMuted" />
                              </children>
                            </HBox>
                            <GridPane fx:id="progressPane" managed="${progressPane.visible}" visible="false">
                              <children>
                                <ProgressBar fx:id="syncProgressBar" maxWidth="Infinity" prefHeight="6.0" progress="0.0" />
                              </children>
                              <columnConstraints>
                                <ColumnConstraints hgrow="ALWAYS" />
                              </columnConstraints>
                            </GridPane>
                          </children>
                        </VBox>
                      </children>
                    </GridPane>

                    <GridPane fx:id="uploadPacketPane" onMouseClicked="#uploadPacketToServer" styleClass="ceinHomeRow">
                      <columnConstraints>
                        <ColumnConstraints minWidth="40.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                      </columnConstraints>
                      <children>
                        <ImageView fx:id="uploadPacketImageView" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true" />
                        <Label styleClass="ceinHomeRowTitle" text="%uploadpacket" GridPane.columnIndex="1" />
                      </children>
                    </GridPane>

                    <GridPane fx:id="downloadPreRegDataPane" onMouseClicked="#downloadPreRegData" styleClass="ceinHomeRow">
                      <columnConstraints>
                        <ColumnConstraints minWidth="40.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                        <ColumnConstraints />
                      </columnConstraints>
                      <children>
                        <ImageView fx:id="downloadPreRegDataImageView" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true" />
                        <VBox spacing="2.0" GridPane.columnIndex="1">
                          <children>
                            <Label styleClass="ceinHomeRowTitle" text="%downloadPreregistrationData" />
                            <Label fx:id="lastPreRegPacketDownloadedTime" styleClass="ceinMuted" />
                          </children>
                        </VBox>
                        <ImageView fx:id="inProgressImage" fitHeight="20.0" fitWidth="20.0" pickOnBounds="true" preserveRatio="true" GridPane.columnIndex="2" />
                      </children>
                    </GridPane>

                    <GridPane fx:id="checkUpdatesPane" onMouseClicked="#hasUpdate" styleClass="ceinHomeRow">
                      <columnConstraints>
                        <ColumnConstraints minWidth="40.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                      </columnConstraints>
                      <children>
                        <ImageView fx:id="checkUpdatesImageView" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true" />
                        <VBox spacing="2.0" GridPane.columnIndex="1">
                          <children>
                            <Label fx:id="checkUpdates" styleClass="ceinHomeRowTitle" text="%checkUpdates" />
                            <HBox spacing="4.0">
                              <children>
                                <Label styleClass="ceinMuted" text="%regClientVersion" />
                                <Label fx:id="versionValueLabel" styleClass="ceinMuted" />
                              </children>
                            </HBox>
                          </children>
                        </VBox>
                      </children>
                    </GridPane>

                    <!-- kept for MOSIP compatibility; hidden in the CEIN configuration
                         (operator onboarding skipped, centre remap handled by the admin) -->
                    <GridPane fx:id="updateOperatorBiometricsPane" managed="false" onMouseClicked="#onBoardUser" styleClass="ceinHomeRow" visible="false">
                      <children>
                        <ImageView fx:id="updateOperatorBiometricsImageView" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true" />
                        <VBox GridPane.columnIndex="1">
                          <children>
                            <Label styleClass="ceinHomeRowTitle" text="%updateOperatorBiometrics" />
                            <Label fx:id="lastBiometricTime" styleClass="ceinMuted" />
                          </children>
                        </VBox>
                      </children>
                    </GridPane>
                    <GridPane fx:id="centerRemapPane" managed="false" onMouseClicked="#intiateRemapProcess" styleClass="ceinHomeRow" visible="false">
                      <children>
                        <ImageView fx:id="remapImageView" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true" />
                        <Label styleClass="ceinHomeRowTitle" text="%remap" GridPane.columnIndex="1" />
                      </children>
                    </GridPane>
                  </children>
                </VBox>

                <!-- end of day: supervisor only (hidden by the controller otherwise) -->
                <GridPane fx:id="eodProcessGridPane" managed="${eodProcessGridPane.visible}" styleClass="ceinCard, ceinHomeList" HBox.hgrow="ALWAYS">
                  <columnConstraints>
                    <ColumnConstraints hgrow="ALWAYS" />
                  </columnConstraints>
                  <children>
                    <Label fx:id="eodLabel" maxWidth="Infinity" styleClass="ceinEyebrow, ceinHomeListTitle" text="%endofDayProcesses" />

                    <GridPane fx:id="eodApprovalPane" onMouseClicked="#approvePacket" styleClass="ceinHomeRow" GridPane.rowIndex="1">
                      <columnConstraints>
                        <ColumnConstraints minWidth="40.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                      </columnConstraints>
                      <children>
                        <ImageView fx:id="eodApprovalImageView" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true" />
                        <VBox spacing="2.0" GridPane.columnIndex="1">
                          <children>
                            <Label styleClass="ceinHomeRowTitle" text="%pendingapproval" />
                            <Label fx:id="pendingApprovalCountLbl" styleClass="ceinMuted" />
                          </children>
                        </VBox>
                      </children>
                    </GridPane>

                    <GridPane fx:id="reRegistrationPane" onMouseClicked="#loadReRegistrationScreen" styleClass="ceinHomeRow" GridPane.rowIndex="2">
                      <columnConstraints>
                        <ColumnConstraints minWidth="40.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                      </columnConstraints>
                      <children>
                        <ImageView fx:id="reRegistrationImageView" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true" />
                        <VBox spacing="2.0" GridPane.columnIndex="1">
                          <children>
                            <Label styleClass="ceinHomeRowTitle" text="%reRegistration" />
                            <Label fx:id="reRegistrationCountLbl" styleClass="ceinMuted" />
                          </children>
                        </VBox>
                      </children>
                    </GridPane>

                    <GridPane fx:id="dashBoardPane" onMouseClicked="#viewDashBoard" styleClass="ceinHomeRow" GridPane.rowIndex="3">
                      <columnConstraints>
                        <ColumnConstraints minWidth="40.0" />
                        <ColumnConstraints hgrow="ALWAYS" />
                      </columnConstraints>
                      <children>
                        <ImageView fx:id="viewReportsImageView" fitHeight="24.0" fitWidth="24.0" pickOnBounds="true" preserveRatio="true" />
                        <Label styleClass="ceinHomeRowTitle" text="%dashBoard" GridPane.columnIndex="1" />
                      </children>
                    </GridPane>
                  </children>
                </GridPane>

              </children>
            </HBox>

            <ProgressIndicator fx:id="progressIndicator" managed="${progressIndicator.visible}" maxHeight="40.0" maxWidth="40.0" visible="false" />
          </children>
        </VBox>
      </content>
    </ScrollPane>
  </children>
</GridPane>
